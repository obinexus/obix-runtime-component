{
  "name": "obix-runtime-component",
  "version": "0.5.0",
  "description": "The components of OBIX's native runtime: it reads canonical DOP IR (obix-dop-ir/3) as plain data and runs it — props, state, derived values, actions, effects, the view — building and updating the DOM in place. No Vue, no React, no compiler package. Phase 6 (docs/recovery/native-runtime.md).",
  "license": "MIT",
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "test",
    "CHANGELOG.md",
    "PROVENANCE.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "obix-runtime-reactivity": "0.5.0",
    "obix-runtime-dom": "0.5.0"
  },
  "keywords": [
    "obix",
    "runtime",
    "component",
    "ir",
    "dop",
    "native"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/obix-runtime-component.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/obix-runtime-component/issues"
  },
  "homepage": "https://github.com/obinexus/obix-runtime-component#readme"
}
